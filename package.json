{
  "name": "@foae/opencode-timings",
  "version": "0.4.0",
  "description": "OpenCode TUI sidebar panel showing per-session timing: total API/inference time, wall-clock, turns, average and slowest turn. Zero context-window pollution.",
  "license": "MIT",
  "author": "foae",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/foae/opencode-timings.git"
  },
  "homepage": "https://github.com/foae/opencode-timings#readme",
  "bugs": {
    "url": "https://github.com/foae/opencode-timings/issues"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "tui",
    "sidebar",
    "timing",
    "duration",
    "metrics",
    "session"
  ],
  "oc-plugin": [
    "tui"
  ],
  "exports": {
    "./tui": {
      "default": "./dist/tui.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "bun": ">=1.0.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "compile": "bun run scripts/build.ts",
    "prepublishOnly": "bun run typecheck && bun run test && bun run compile"
  },
  "peerDependencies": {
    "@opencode/plugin": "latest",
    "@opentui/core": ">=0.6.6",
    "@opentui/solid": ">=0.6.6",
    "solid-js": ">=1.9.0"
  },
  "peerDependenciesMeta": {
    "@opencode/plugin": {
      "optional": true
    },
    "@opentui/core": {
      "optional": true
    },
    "@opentui/solid": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    }
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@babel/preset-typescript": "^7.26.0",
    "@types/babel__core": "^7.20.5",
    "babel-preset-solid": "^1.9.3",
    "@opencode/client": "latest",
    "@opencode/plugin": "latest",
    "@opentui/core": "^0.6.6",
    "@opentui/solid": "^0.6.6",
    "@types/bun": "^1.1.0",
    "@types/node": "^22.0.0",
    "solid-js": "1.9.12",
    "typescript": "^5.8.0"
  }
}
